#!/bin/bash

set -e

REBUILD_BASE=0
if [[ "$1" == "--base" ]]; then
    REBUILD_BASE=1
    shift
fi

if [ -z "$1" ]; then
    echo "Usage: ./build [--base] <spec-tag>"
    echo "  ./build alpine                  - build localhost/contain:alpine"
    echo "  ./build hard-fedora/trivalent   - build localhost/contain:hard-fedora--trivalent"
    exit 1
fi

SPEC_TAG="$1"

# Resolve spec directory from tag.
# "a/b/c" -> ./specs/a/children/b/children/c/definition
spec_dir() {
    local tag="$1" dir="./specs"
    IFS='/' read -ra parts <<< "$tag"
    for ((i=0; i<${#parts[@]}; i++)); do
        ((i > 0)) && dir="$dir/children"
        dir="$dir/${parts[$i]}"
    done
    echo "$dir/definition"
}

SPEC_DIR=$(spec_dir "$SPEC_TAG")

find_spec_file() {
    local tag filename t
    tag="$1" filename="$2"
    t="$tag"
    while true; do
        local dir
        dir=$(spec_dir "$t")
        if [ -f "$dir/$filename" ]; then
            echo "$dir/$filename"
            return 0
        fi
        [[ "$t" == */* ]] || break
        t="${t%/*}"
    done
    return 1
}

if ! CONTAINERFILE=$(find_spec_file "$SPEC_TAG" Containerfile); then
    echo "Error: no Containerfile found for $SPEC_TAG or any of its parents"
    exit 1
fi

# Derive image tag: replace "/" with "--"
TAG="localhost/contain:${SPEC_TAG//\//--}"

# Derive BASE from parent path and auto-build it if missing
BASE=""
if [[ "$SPEC_TAG" == */* ]]; then
    PARENT_TAG="${SPEC_TAG%/*}"
    BASE="localhost/contain:${PARENT_TAG//\//--}"
    if [ "$REBUILD_BASE" -eq 1 ] || ! podman image exists "$BASE"; then
        echo "Building parent $BASE..."
        "$0" "$PARENT_TAG"
    fi
fi

BUILD_ARG_FLAGS=()
[ -n "$BASE" ] && BUILD_ARG_FLAGS+=(--build-arg "BASE=$BASE")

# Read build.args for any additional custom args (TAG and BASE are derived from path)
BUILDARGS_FILE=$(find_spec_file "$SPEC_TAG" build.args || true)
if [ -n "$BUILDARGS_FILE" ]; then
    while IFS='=' read -r key value; do
        [[ -z "$key" || "$key" == \#* ]] && continue
        [[ "$key" == TAG || "$key" == BASE ]] && continue
        BUILD_ARG_FLAGS+=(--build-arg "$key=$value")
    done < "$BUILDARGS_FILE"
fi

echo "------------------------------------------"
echo "Building $TAG from $CONTAINERFILE"
echo "------------------------------------------"
podman build -t "$TAG" -f "$CONTAINERFILE" "$SPEC_DIR" "${BUILD_ARG_FLAGS[@]}"
echo "Build complete: $TAG"
