#!/bin/bash

set -e

SCRIPT_PATH="$(realpath "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
SPECS_DIR="${SCRIPT_DIR}/specs"
INSTANCES_DIR="${SCRIPT_DIR}/instances"
cd "${SCRIPT_DIR}"

REBUILD=0
SHELL_MODE=0
UPDATE=0
DIRECT_DBUS=0
INSTANCE=""

while [[ "$1" == --* ]]; do
    case "$1" in
        --rebuild) REBUILD=1 ;;
        --build) REBUILD=1 ;;
        --shell)   SHELL_MODE=1 ;;
        --update)  UPDATE=1 ;;
        --setup)  UPDATE=1 ;;
        --dbus)    DIRECT_DBUS=1 ;;
        --name) shift; INSTANCE="$1" ;;
        *) echo "Unknown option: $1"; exit 1 ;;
    esac
    shift
done
SPEC_TAG="$1"
shift
APP_ARGS=("$@")

# Resolve spec directory from tag.
# "a/b/c" -> $SPECS_DIR/a/children/b/children/c/definition
spec_dir() {
    local tag="$1" dir="$SPECS_DIR"
    IFS='/' read -ra parts <<< "$tag"
    for ((i=0; i<${#parts[@]}; i++)); do
        ((i > 0)) && dir="$dir/children"
        dir="$dir/${parts[$i]}"
    done
    echo "$dir/definition"
}

if [ "$INSTANCE" == "" ]; then
    INSTANCE="${SPEC_TAG//\//--}"
fi
echo "Executing $SPEC_TAG ($INSTANCE)"

TMP_DIR=$(mktemp -d)
DBUS_PROXY_SOCK="$TMP_DIR/dbus.sock"
WAYLAND_PROXY_SOCK="$TMP_DIR/wayland.sock"
PULSE_PROXY_SOCK="$TMP_DIR/pulse.sock"
PIPEWIRE_PROXY_SOCK="$TMP_DIR/pipewire.sock"
KILL_PIDS=()
cleanup() {
    echo "Killing pids: ${KILL_PIDS[*]}"
    for pid in "${KILL_PIDS[@]}"; do
        if kill -0 "$pid" 2>/dev/null; then
            echo "Killing pid $pid..."
            kill -9 "$pid" 2>/dev/null || true
        fi
    done
    echo "Cleaning up proxy sockets..."
    # Look for any processes still using the proxy sockets and kill them
    for sock in "$DBUS_PROXY_SOCK" "$WAYLAND_PROXY_SOCK" "$PULSE_PROXY_SOCK" "$PIPEWIRE_PROXY_SOCK"; do
        if [ -S "$sock" ]; then
            echo "Checking for processes using $sock..."
            pids=$(lsof -t "$sock")
            if [ -n "$pids" ]; then
                echo "Killing processes using $sock: $pids"
                kill -9 $pids 2>/dev/null || true
            fi
        else
            echo "Socket $sock does not exist or is not a socket."
        fi
    done
    echo "Removing temporary directory $TMP_DIR..."
    rm -rf "$TMP_DIR"
    echo "Cleanup complete."
}


SPEC=$(spec_dir "$SPEC_TAG")

find_spec_file() {
    local tag filename t
    tag="$1" filename="$2"
    t="$tag"
    while true; do
        local dir
        dir=$(spec_dir "$t")
        if [ -f "$dir/$filename" ]; then
            echo "$dir/$filename"
            return 0
        fi
        [[ "$t" == */* ]] || break
        t="${t%/*}"
    done
    return 1
}

# Resolve image tag: nearest ancestor (inclusive) that owns a Containerfile or build.args
resolve_image_tag() {
    local t dir
    t="$1"
    while true; do
        dir=$(spec_dir "$t")
        if [ -f "$dir/Containerfile" ] || [ -f "$dir/build.args" ]; then
            echo "$t"
            return 0
        fi
        [[ "$t" == */* ]] || break
        t="${t%/*}"
    done
    return 1
}

echo "Resolving" > tmp.log
IMAGE_TAG=$(resolve_image_tag "$SPEC_TAG") || { echo "Error: no Containerfile or build.args found for $SPEC_TAG or any parent"; exit 1; }
echo "Resolved image tag: $IMAGE_TAG"
IMAGE="localhost/contain:${IMAGE_TAG//\//--}"
CONTAIN_ROOTFS="$HOME/.local/share/contain/$INSTANCE"
CONTAIN_HOME_GUEST="/home/user"
export CONTAIN_HOME_GUEST
CONTAIN_HOME="${CONTAIN_ROOTFS}/${CONTAIN_HOME_GUEST#"/"}"
DESKTOP_ENTRY_DIR=${DESKTOP_ENTRY_DIR:-"$HOME/.local/share/applications"}
UID_HOST=$(id -u)
UID_GUEST=${UID_GUEST:-1000}
XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$UID_HOST}
#XDG_RUNTIME_DIR_GUEST=${XDG_RUNTIME_DIR_GUEST:-"$XDG_RUNTIME_DIR_GUEST"}
XDG_RUNTIME_DIR_GUEST=${XDG_RUNTIME_DIR_GUEST:-"${CONTAIN_HOME_GUEST}/.xdg-runtime-dir"}
WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0}
WAYLAND_SOCK="${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}"


if [ ! -d "$SPEC" ]; then
    echo "Error: no spec found at $SPEC"
    exit 1
fi

echo "Using spec tag: $SPEC_TAG"
SPEC_INIT=$(find_spec_file "$SPEC_TAG" init.sh)     || { echo "Error: no init.sh found for $SPEC_TAG"; exit 1; }
SPEC_DBUS=$(find_spec_file "$SPEC_TAG" run.dbus)    || { echo "Error: no run.dbus found for $SPEC_TAG"; exit 1; }
SPEC_PODMAN=$(find_spec_file "$SPEC_TAG" run.podman || true)
SPEC_NET_MAP=$(find_spec_file "$SPEC_TAG" run.net.map-guest-addr || true)
SPEC_DESKTOP=$(find_spec_file "$SPEC_TAG" desktop || true)
SPEC_SETUP=$(find_spec_file "$SPEC_TAG" setup.sh || true)
SPEC_SETUP_USER=$(find_spec_file "$SPEC_TAG" setup.user.sh || true)
SPEC_INIT_ROOT=$(find_spec_file "$SPEC_TAG" init.root.sh || true)

trap cleanup EXIT

# Build image if it doesn't exist (or rebuild is forced)
if ! podman image exists "$IMAGE"; then
    echo "Image $IMAGE not found!"
    REBUILD=1
fi

if [ "$REBUILD" -eq 1 ]; then
    echo "Building image $IMAGE..."
    ./build "$IMAGE_TAG"
    UPDATE=1
fi

# Auto-export desktop entry if spec provides one
if [ -n "$SPEC_DESKTOP" ]; then
    SUFFIX=""
    SPEC_TAG_ID="${SPEC_TAG//\//--}"
    if [ "$INSTANCE" != "$SPEC_TAG_ID" ]; then
        SUFFIX=" ($INSTANCE)"
    fi
    DEST="$DESKTOP_ENTRY_DIR/contain-$SPEC_TAG_ID-$INSTANCE.desktop"
    SUFFIX="$SUFFIX" SCRIPT_DIR="$SCRIPT_DIR" SCRIPT_PATH="$SCRIPT_PATH" SPEC_TAG="$SPEC_TAG" INSTANCE="$INSTANCE" SPEC="$(dirname "$SPEC_DESKTOP")" \
        envsubst '$SPEC_TAG $INSTANCE $SCRIPT_PATH $SCRIPT_DIR $SUFFIX $SPEC' < "$SPEC_DESKTOP" > "$DEST"
    update-desktop-database "$DESKTOP_ENTRY_DIR"
    echo "Installed desktop entry: $DEST"
fi

mkdir -p "$CONTAIN_HOME"

# Load spec files
export HOME SPEC CONTAIN_HOME_GUEST
mapfile -t DBUS_NAMES   < "$SPEC_DBUS"
mapfile -t PODMAN_EXTRA < <([ -n "$SPEC_PODMAN" ] && grep -v '^#' "$SPEC_PODMAN" || true)

readarray -t DBUS_NAMES < <(printf '%s\n' "${DBUS_NAMES[@]}" | grep -v '^$')
readarray -t PODMAN_EXTRA < <(printf '%s\n' "${PODMAN_EXTRA[@]}" | grep -v '^$' | envsubst)

# Get host GIDs
RENDER_GID=$(getent group render | cut -d: -f3)

# Start D-Bus proxy
if [ "$DIRECT_DBUS" -eq 1 ]; then
    DBUS_PROXY_SOCK="$XDG_RUNTIME_DIR_GUEST/bus"
else
    PROXY_ARGS=(--filter)
    for name in "${DBUS_NAMES[@]}"; do
        PROXY_ARGS+=("--talk=$name")
    done
    DBUS_NATIVE_PROXY_SOCK="$DBUS_PROXY_SOCK.native"
    xdg-dbus-proxy "$DBUS_SESSION_BUS_ADDRESS" "$DBUS_NATIVE_PROXY_SOCK" "${PROXY_ARGS[@]}" &
    KILL_PIDS+=($!)
    while [ ! -S "$DBUS_NATIVE_PROXY_SOCK" ]; do sleep 0.1; done
    #"$SCRIPT_DIR/proxy-socket" "$DBUS_PROXY_SOCK" "$DBUS_NATIVE_PROXY_SOCK" &
    #KILL_PIDS+=($!)
    DBUS_PROXY_SOCK="$DBUS_NATIVE_PROXY_SOCK"
fi

# Start socket proxies for Wayland, PulseAudio, and PipeWire.
# These let the container run as a different UID without needing setfacl
# on the real compositor/audio sockets.

"$SCRIPT_DIR/proxy-socket" "$WAYLAND_PROXY_SOCK"  "$WAYLAND_SOCK" &
KILL_PIDS+=($!)
"$SCRIPT_DIR/proxy-socket" "$PULSE_PROXY_SOCK"    "${XDG_RUNTIME_DIR}/pulse/native" &
KILL_PIDS+=($!)
"$SCRIPT_DIR/proxy-socket" "$PIPEWIRE_PROXY_SOCK" "${XDG_RUNTIME_DIR}/pipewire-0" &
KILL_PIDS+=($!)

for sock in "$DBUS_PROXY_SOCK" "$WAYLAND_PROXY_SOCK" "$PULSE_PROXY_SOCK" "$PIPEWIRE_PROXY_SOCK"; do
    while [ ! -S "$sock" ]; do sleep 0.05; done
done

PODMAN_RUN=("podman" "run")

# Flags shared between postbuild and normal run
COMMON_FLAGS=()
for extra in "${PODMAN_EXTRA[@]}"; do
    COMMON_FLAGS+=("$extra")
done
has_flag() {
    local flag="$1"
    for f in "${COMMON_FLAGS[@]}"; do
        if [[ "$f" == "$flag" || "$f" == "$flag="* ]]; then
            return 0
        fi
    done
    return 1
}
add_flag() {
    local flag="$1" value="$2"
    if [ -n "$value" ]; then
        COMMON_FLAGS+=("$flag" "$value")
    else
        COMMON_FLAGS+=("$flag")
    fi
}
add_flag_if_not_exists() {
    local flag="$1" value="$2"
    if ! has_flag "$flag"; then
        add_flag "$flag" "$value"
    fi
}
#COMMON_FLAGS+=("--name" "contain-$SPEC_TAG")
#COMMON_FLAGS+=("--cap-drop" "ALL")
add_flag "--security-opt" "no-new-privileges"
add_flag "--security-opt" "label=type:container_runtime_t"
#COMMON_FLAGS+=("--cap-add" "ALL")
add_flag_if_not_exists "--userns" "keep-id" #:uid=$UID_GUEST,gid=$UID_GUEST")
NET_PASTA_ARGS="pasta"
if [ -n "$SPEC_NET_MAP" ]; then
    while IFS= read -r addr || [ -n "$addr" ]; do
        [[ -z "$addr" || "$addr" == \#* ]] && continue
        NET_PASTA_ARGS+=":--map-guest-addr,$addr"
    done < "$SPEC_NET_MAP"
fi
add_flag_if_not_exists "--network" "$NET_PASTA_ARGS"
XDG_RUNTIME_GUEST_HOST="$TMP_DIR/xdg-runtime"
mkdir -p "$XDG_RUNTIME_GUEST_HOST"
add_flag "-v" "$XDG_RUNTIME_GUEST_HOST:$XDG_RUNTIME_DIR_GUEST"
add_flag "-v" "$WAYLAND_PROXY_SOCK:$XDG_RUNTIME_DIR_GUEST/$WAYLAND_DISPLAY:ro"
add_flag "-v" "$PIPEWIRE_PROXY_SOCK:$XDG_RUNTIME_DIR_GUEST/pipewire-0:rw"
add_flag "-v" "$DBUS_PROXY_SOCK:$XDG_RUNTIME_DIR_GUEST/bus:rw"
add_flag "-v" "$PULSE_PROXY_SOCK:$XDG_RUNTIME_DIR_GUEST/pulse/native"
add_flag "-v" "$CONTAIN_HOME:$CONTAIN_HOME_GUEST:Z"
add_flag "-e" "HOME=$CONTAIN_HOME_GUEST"
add_flag "-e" "INSTANCE=$INSTANCE"
add_flag "-e" "UID_GUEST=$UID_GUEST"
add_flag "-e" "GTK_THEME=Adwaita:dark"
add_flag "-e" "DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR_GUEST/bus"
add_flag "-e" "PULSE_SERVER=unix:$XDG_RUNTIME_DIR_GUEST/pulse/native"
add_flag "-e" "PIPEWIRE_REMOTE=$XDG_RUNTIME_DIR_GUEST/pipewire-0"
add_flag "-e" "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR_GUEST"
add_flag "-e" "WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
add_flag "-e" "XDG_SESSION_TYPE=wayland"
COMMON_FLAGS+=("$IMAGE")

echo "${PODMAN_RUN[@]}" -i --rm -v "$(realpath "$SPEC_INIT"):/init.sh:ro" --cap-drop ALL "${COMMON_FLAGS[@]}" dbus-run-session -- bash /init.sh "${APP_ARGS[@]}"

if [ "$UPDATE" -eq 1 ] && [ -n "$SPEC_SETUP" ]; then
    echo "Running postbuild script for $SPEC_TAG..."
    "${PODMAN_RUN[@]}" -it --rm \
        --user 0:0 \
        --cap-add ALL \
        -v "$(realpath "$SPEC_SETUP"):/setup.sh:ro" \
        "${COMMON_FLAGS[@]}"  \
        dbus-run-session -- bash /setup.sh
fi

if [ "$UPDATE" -eq 1 ] && [ -n "$SPEC_SETUP_USER" ]; then
    echo "Running postbuild user script for $SPEC_TAG..."
    "${PODMAN_RUN[@]}" -it --rm \
        -v "$(realpath "$SPEC_SETUP_USER"):/setup.sh:ro" \
        "${COMMON_FLAGS[@]}"  \
        dbus-run-session -- bash /setup.sh
fi

if [ -n "$SPEC_INIT_ROOT" ]; then
    echo "Running init script as root for $SPEC_TAG..."
    "${PODMAN_RUN[@]}" -it --rm \
        --user 0:0 \
        --cap-add ALL \
        -v "$(realpath "$SPEC_INIT_ROOT"):/init.sh:ro" \
        "${COMMON_FLAGS[@]}"  \
        dbus-run-session -- bash /init.sh
fi

if [ "$SHELL_MODE" -eq 1 ]; then
    echo "Starting shell in container for $SPEC_TAG..."
    "${PODMAN_RUN[@]}" -it --rm \
        "${COMMON_FLAGS[@]}" \
        dbus-run-session -- bash
else
    echo "Starting container for $SPEC_TAG..."
    echo "${PODMAN_RUN[@]}" -i --rm \
        -v "$(realpath "$SPEC_INIT"):/init.sh:ro" \
        --cap-drop ALL \
        "${COMMON_FLAGS[@]}" \
        "${APP_ARGS[@]}" 
    "${PODMAN_RUN[@]}" -i --rm \
        -v "$(realpath "$SPEC_INIT"):/init.sh:ro" \
        --cap-drop ALL \
        "${COMMON_FLAGS[@]}" \
        "${APP_ARGS[@]}" 
    #sh
fi
